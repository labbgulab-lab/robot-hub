# Copy to .env (gitignored). Never commit real values; never log them.

# Furhat Realtime API key -- per-install, regenerated in Furhat Studio.
FURHAT_API_KEY=

# Furhat Studio web login, if not set in config.toml.
FURHAT_PASSWORD=

# The wireless Reachy's SSH password, used to clear leftover processes on the
# robot before launching. Defaults to Pollen's factory login if unset.
REACHY_SSH_PASSWORD=

# NAO's SSH password -- needed only for WiFi provisioning, not for the hub.
NAO_SSH_PASSWORD=

# Passed through to NAO_LLM when the hub launches it.
GEMINI_API_KEY=
OPENAI_API_KEY=
